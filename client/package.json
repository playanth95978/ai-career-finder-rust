{
  "name": "job-search-rust",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "Description for Job Search Rust",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run webapp:prod --",
    "build-watch": "concurrently 'npm run webapp:build:dev -- --watch' npm:backend:start",
    "ci:frontend:build": "npm run webapp:build:$npm_package_config_default_environment",
    "ci:frontend:test": "npm run ci:frontend:build && npm test",
    "clean-www": "rimraf ../server/dist/static/",
    "cleanup": "rimraf ../tmp/",
    "postinstall": "node scripts/copy-swagger-ui-assets.cjs",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "serve": "npm run start --",
    "prestart": "node scripts/copy-swagger-ui-assets.cjs",
    "start": "ng serve --hmr",
    "start-tls": "npm run webapp:dev-ssl",
    "pretest": "npm run lint",
    "test": "ng test --coverage",
    "test:watch": "npm run test -- --watch",
    "watch": "concurrently npm:start npm:backend:start",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev",
    "webapp:build:dev": "ng build --configuration development",
    "webapp:build:prod": "ng build --configuration production",
    "webapp:dev": "ng serve",
    "webapp:dev-ssl": "ng serve --ssl",
    "webapp:dev-verbose": "ng serve --verbose",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod",
    "webapp:test": "npm run test --"
  },
  "config": {
    "default_environment": "prod"
  },
  "dependencies": {
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/localize": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "@fortawesome/angular-fontawesome": "4.0.0",
    "@fortawesome/free-solid-svg-icons": "7.3.0",
    "@ng-bootstrap/ng-bootstrap": "20.0.0",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.21",
    "ngx-infinite-scroll": "21.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "21.1.0",
    "@angular/build": "21.2.18",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.17",
    "@angular/service-worker": "21.2.17",
    "@eslint/js": "10.0.1",
    "@types/folder-hash": "4.0.4",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "21.4.0",
    "browser-sync": "3.0.4",
    "concurrently": "10.0.3",
    "deepmerge": "4.3.1",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "folder-hash": "4.1.3",
    "globals": "17.7.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "rimraf": "6.1.3",
    "swagger-ui-dist": "5.32.8",
    "tinyglobby": "0.2.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.0.10"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
