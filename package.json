{
  "name": "job-search-rust",
  "version": "0.0.0",
  "description": "Description for Job Search Rust",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "app:up": "docker compose -f docker/app.yml up --wait",
    "build": "npm run -w client/ build",
    "ci:e2e:prepare": "npm run ci:e2e:prepare:docker",
    "ci:e2e:prepare:docker": "npm run services:up --if-present && docker ps -a",
    "ci:e2e:teardown": "npm run ci:e2e:teardown:docker --if-present",
    "ci:e2e:teardown:docker": "docker compose -f docker/services.yml down -v && docker ps -a",
    "ci:frontend:test": "npm run -w client/ ci:frontend:test",
    "docker:db:down": "docker compose -f docker/postgresql.yml down -v",
    "docker:db:up": "docker compose -f docker/postgresql.yml up --wait",
    "lint": "npm run -w client/ lint",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,.blueprint/**/,src/**/,build-plugins/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,css,scss}\"",
    "prettier:format": "prettier --write \"{,.blueprint/**/,src/**/,build-plugins/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,java,html,css,scss}\"",
    "services:up": "docker compose -f docker/services.yml up --wait",
    "start": "npm run -w client/ start",
    "test": "npm run -w client/ test",
    "webapp:build": "npm run -w client/ webapp:build"
  },
  "config": {
    "default_environment": "prod"
  },
  "overrides": {
    "browser-sync": "3.0.4",
    "webpack": "5.108.4"
  },
  "devDependencies": {
    "generator-jhipster": "9.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-packagejson": "3.0.2"
  }
}
