# jobSearchRust Environment Configuration — EXAMPLE TEMPLATE
#
# This file is the sanitized template suitable for committing to git.
# The generator also creates a working `.env` alongside it with a CSPRNG-
# generated `JWT_SECRET`; that `.env` is what `cargo run` actually reads.
#
# Workflow:
#   - First run: edit `.env` (already has working defaults) and `cargo run`.
#   - Sharing the project: commit this `.env.example`, gitignore `.env`,
#     and document that contributors copy `.env.example` to `.env` and
#     replace placeholders before running.
#
# Running `cp .env.example .env && cargo run` against this template
# unmodified will fail before the app is usable: JWT scaffolds FATAL at
# startup because JWT_SECRET below is a known-default sentinel; OAuth2
# scaffolds fail at the first login attempt because OIDC_CLIENT_SECRET
# is a placeholder; SQL/MongoDB scaffolds fail at DB connect because
# DATABASE_URL/MONGODB_URI carry literal `<user>:<password>` placeholders.
# Replace before running. See RELEASE_NOTES.md.

# Application
APP_NAME=jobSearchRust
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
# Set to true when using HTTPS (e.g., in production with TLS)
# APP_HTTPS=false

# Database
# Replace <user>:<password> with your PostgreSQL credentials before running.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/jobSearchRust

# JWT Configuration
# REQUIRED: replace before running. Generate with: openssl rand -hex 32
# The application refuses to start with the value below — it is one of the
# known-default sentinels enforced by the entrypoint and by the Rust binary.
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=24

# Static Files Configuration
# Set SERVE_STATIC_FILES=true to serve the SPA UI from the Rust backend
# STATIC_FILES_DIR specifies the directory containing the built Angular/React/Vue app
# SERVE_STATIC_FILES=true
# STATIC_FILES_DIR=./static








# Logging
RUST_LOG=info,jobSearchRust=debug,tower_http=debug
